{
  "name": "gifaa-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:safari": "wxt build -b safari --mv3",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "safari:convert": "wxt build -b safari --mv3 && xcrun safari-web-extension-converter .output/safari-mv3 --project-location safari --app-name Gifaa --bundle-identifier in.gifaa.extension --swift --copy-resources --no-open --no-prompt --force"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wxt": "^0.21.5"
  }
}
